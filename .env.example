# Active Digest Users (comma-separated, defaults to default)
DIGEST_USERS=default
DEFAULT_USER=default

# Root Archive Directory (per-user folders created at ~/Documents/digest/<user>/)
DIGEST_ARCHIVE_ROOT=~/Documents/digest

# Garmin Connect Credentials (supports per-user USER_GARMIN_* or default GARMIN_*)
GARMIN_USERNAME=user@example.com
GARMIN_PASSWORD=your_garmin_password

# Weather & Work Coordinates (Open-Meteo)
HOME_LOCATION_NAME=East Gwillimbury
HOME_LAT=44.1008
HOME_LON=-79.4397

WORK_LOCATION_NAME=East Gwillimbury
TORONTO_LOCATION_NAME=Downtown Toronto
TORONTO_LAT=43.6532
TORONTO_LON=-79.3832

# CUPS Thermal Printer Configuration
PRINTER_NAME=Phomemo_M834
