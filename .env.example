# Active Digest Users (comma-separated, defaults to vedant)
DIGEST_USERS=vedant
DEFAULT_USER=vedant

# Root Archive Directory (per-user folders created at ~/Documents/digest/<user>/)
DIGEST_ARCHIVE_ROOT=~/Documents/digest

# Garmin Connect Credentials (supports per-user VEDANT_GARMIN_* or default GARMIN_*)
GARMIN_USERNAME=vedant172000@gmail.com
GARMIN_PASSWORD=your_garmin_password

# Weather Coordinates (Open-Meteo — East Gwillimbury & Downtown Toronto)
HOME_LOCATION_NAME=East Gwillimbury
HOME_LAT=44.1008
HOME_LON=-79.4397

TORONTO_LOCATION_NAME=Downtown Toronto
TORONTO_LAT=43.6532
TORONTO_LON=-79.3832

# CUPS Thermal Printer Configuration
PRINTER_NAME=Phomemo_M834
